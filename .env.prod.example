# =============================================================================
# TradeMind 环境变量 — Docker Compose 生产部署（docker-compose.prod.yml）
# =============================================================================
#
# 【本文件用途】
#   `docker compose -f docker-compose.prod.yml up -d` 使用的变量示例
#   （Caddy HTTPS + Postgres + Redis + backend + admin + collector）。
#
# 【如何使用】
#   cp .env.prod.example .env
#   填入所有「必填」项后再启动；`.env` 已被 .gitignore 忽略，切勿提交。
#
# 【安全要求（必读）】
#   - 所有留空的必填密钥必须填入强随机值，生成方式示例：
#       openssl rand -hex 32     # APP_MASTER_KEY（64 位十六进制，32 字节）
#       openssl rand -base64 48  # JWT_SECRET / 数据库密码
#   - 不得把真实密钥、AI Key、平台凭证提交到仓库或写入镜像。
#   - APP_ENV=production 时后端会对弱密钥 fail-fast 拒绝启动。
#
# 【配置文件索引】本地 Docker 试用用 .env.docker.example；裸机生产用 .env.production.example。
# 详见 docs/production-deployment.md
# =============================================================================

# -----------------------------------------------------------------------------
# 域名与 HTTPS（Caddy）
# -----------------------------------------------------------------------------
# 必填：公网域名（DNS A 记录须指向本服务器；本地验证可临时用 localhost）
DOMAIN=
# 必填：Let's Encrypt 证书到期/异常通知邮箱
ACME_EMAIL=
# 选填：ACME CA。默认 Let's Encrypt 正式环境；联调可用 staging 避免触发签发限额：
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

APP_ENV=production
GIN_MODE=release
APP_HTTP_ADDR=:8080

# 必填：前后端对外地址（均经 Caddy 同域名提供；写完整 URL，如 https://trademind.example.com）
ADMIN_PUBLIC_URL=
API_PUBLIC_URL=

# -----------------------------------------------------------------------------
# 核心密钥（全部必填，使用强随机值）
# -----------------------------------------------------------------------------
# 必填：AES-GCM 主密钥，64 位十六进制（openssl rand -hex 32）
APP_MASTER_KEY=
# 必填：JWT 签名密钥（openssl rand -base64 48）
JWT_SECRET=
# 必填：分页 cursor 签名密钥（openssl rand -hex 32）
PAGINATION_CURSOR_SIGNING_KEY=
JWT_EXPIRE_HOURS=168

# 必填：首个管理员账号（首次启动引导创建；登录后立即修改密码）
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PHONE=
ADMIN_BOOTSTRAP_PASSWORD=
# 0 = 平台租户：引导账号即平台管理员，可开租/停用/改名；业务租户经「平台租户管理」创建。
# 仅遗留单租户部署才显式设 >0。详见 docs/env.md
ADMIN_BOOTSTRAP_TENANT_ID=0

# -----------------------------------------------------------------------------
# 生产 fail-fast 必填项
# -----------------------------------------------------------------------------
# 必填：生产禁止 local storage。填 cos / oss / s3 / r2 / minio，
# 须与管理端「系统设置 → 存储」实际配置一致（对象存储密钥在管理端配置，加密入库，不写在此处）
STORAGE_PROVIDER=
# 必填：CORS 白名单，与 ADMIN_PUBLIC_URL 一致（多域逗号分隔）
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=true

# 多实例滚动发布时串行迁移（PostgreSQL advisory lock）
MIGRATION_RUN_ON_STARTUP=true
MIGRATION_LOCK_TIMEOUT_SECONDS=120

# -----------------------------------------------------------------------------
# PostgreSQL（compose postgres 服务 + GORM；不暴露公网端口）
# -----------------------------------------------------------------------------
POSTGRES_DB=trademind
POSTGRES_USER=trademind
# 必填：强随机数据库密码，POSTGRES_PASSWORD 与 DB_PASSWORD 必须一致
POSTGRES_PASSWORD=
DB_DRIVER=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USER=trademind
DB_PASSWORD=
DB_NAME=trademind
DB_TIMEZONE=UTC

# -----------------------------------------------------------------------------
# Redis（不暴露公网端口）
# -----------------------------------------------------------------------------
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# -----------------------------------------------------------------------------
# 可观测性（未接真实 telemetry backend 时 OTLP endpoint 保持为空）
# -----------------------------------------------------------------------------
OBSERVABILITY_ENABLED=true
OBSERVABILITY_MODE=hybrid
OBSERVABILITY_ENVIRONMENT=production
LOG_FORMAT=json
LOG_LEVEL=info
METRICS_ENABLED=true
METRICS_INTERNAL_ONLY=true
TRACING_ENABLED=false
OTEL_SERVICE_NAME=trademind-api
OTEL_SERVICE_VERSION=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/json
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_INSECURE=false
OTEL_TRACE_SAMPLE_RATIO=0
OTEL_EXPORT_TIMEOUT_SECONDS=10
OTEL_EXPORT_QUEUE_SIZE=1024
OTEL_EXPORT_BATCH_SIZE=128
OTEL_EXPORT_RETRY_MAX=2

# -----------------------------------------------------------------------------
# Collector ↔ Backend（编排网络内服务名，不暴露公网）
# -----------------------------------------------------------------------------
COLLECTOR_BASE_URL=http://collector:3001
COLLECTOR_TIMEOUT_SECONDS=120
COLLECTOR_HTTP_ADDR=:3001
COLLECTOR_MAIN_SERVICE_URL=http://backend:8080
COLLECTOR_GOTO_TIMEOUT_MS=45000
COLLECTOR_HEADLESS=1

# -----------------------------------------------------------------------------
# 异步队列（与 .env.docker.example 默认对齐）
# -----------------------------------------------------------------------------
COLLECT_QUEUE_ENABLED=true
COLLECT_WORKER_CONCURRENCY=2
COLLECT_QUEUE_NAME=collect:tasks
COLLECT_BATCH_MAX_URLS=50
COLLECT_AUTO_RETRY_ENABLED=true
COLLECT_MAX_RETRIES=3
COLLECT_RETRY_BASE_DELAY_SECONDS=30
COLLECT_RETRY_MAX_DELAY_SECONDS=600
COLLECT_TASK_TIMEOUT_SECONDS=600

IMAGE_QUEUE_ENABLED=true
IMAGE_QUEUE_NAME=image:tasks
IMAGE_WORKER_CONCURRENCY=2
IMAGE_TASK_TIMEOUT_SECONDS=120
AI_IMAGE_PROVIDER_TIMEOUT_SECONDS=120
AI_IMAGE_TASK_MAX_RUNTIME_SECONDS=300
AI_IMAGE_POLL_INTERVAL_SECONDS=5
AI_IMAGE_TRIAL_TIMEOUT_SECONDS=600
IMAGE_AUTO_RETRY_ENABLED=true
IMAGE_MAX_RETRIES=2
IMAGE_RETRY_BASE_DELAY_SECONDS=30
IMAGE_RETRY_MAX_DELAY_SECONDS=300

ORDER_SYNC_QUEUE_ENABLED=true
ORDER_SYNC_QUEUE_NAME=order:sync:tasks
ORDER_SYNC_WORKER_CONCURRENCY=1
ORDER_SYNC_TASK_TIMEOUT_SECONDS=120

CUSTOMER_MESSAGE_SYNC_QUEUE_ENABLED=true
CUSTOMER_MESSAGE_SYNC_QUEUE_NAME=customer:message:sync:tasks
CUSTOMER_MESSAGE_SYNC_WORKER_CONCURRENCY=1
CUSTOMER_MESSAGE_SYNC_TASK_TIMEOUT_SECONDS=120

PRODUCT_PUBLISH_QUEUE_ENABLED=true
PRODUCT_PUBLISH_QUEUE_NAME=product:publish:tasks
PRODUCT_PUBLISH_WORKER_CONCURRENCY=1
PRODUCT_PUBLISH_TASK_TIMEOUT_SECONDS=180

INVENTORY_SYNC_QUEUE_ENABLED=true
INVENTORY_SYNC_QUEUE_NAME=inventory:sync:tasks
INVENTORY_SYNC_WORKER_CONCURRENCY=1
INVENTORY_SYNC_TASK_TIMEOUT_SECONDS=120

WORKER_HEARTBEAT_ENABLED=true
WORKER_HEARTBEAT_INTERVAL_SECONDS=10
WORKER_STALE_AFTER_SECONDS=30
WORKER_REAPER_ENABLED=true
WORKER_REAPER_INTERVAL_SECONDS=15
WORKER_LEGACY_RUNNING_TIMEOUT_SECONDS=1800

TASK_ALERT_SCAN_ENABLED=false
TASK_ALERT_SCAN_INTERVAL_SECONDS=60
TASK_ALERT_SCAN_LOOKBACK_MINUTES=120
TASK_ALERT_SCAN_LOCK_TTL_SECONDS=120

# -----------------------------------------------------------------------------
# 备份 / 发布（生产 fail-fast：BACKUP_ENABLED=true + object_storage/hybrid + 加密）
# -----------------------------------------------------------------------------
BACKUP_ENABLED=true
BACKUP_MODE=object_storage
# 注意：BACKUP_SCHEDULE 仅为元数据，后端当前没有内置定时器；每日自动备份必须按
# docs/production-deployment.md「备份与恢复」配置宿主机 crontab（pg_dump）或经
# POST /api/v1/ops/backups 由外部调度触发
BACKUP_SCHEDULE=0 3 * * *
BACKUP_STORAGE_PROVIDER=s3
# 备份对象存储 bucket（上线后尽快配置；为空时 /ops/backups 备份会失败，另见 SOP 的 pg_dump 兜底备份）
BACKUP_STORAGE_BUCKET=
BACKUP_STORAGE_PREFIX=backups/prod
BACKUP_ENCRYPTION_ENABLED=true
BACKUP_ENCRYPTION_KEY_ID=app-master-key
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=6
BACKUP_MAX_AGE_HOURS=30
BACKUP_COMMAND_TIMEOUT_SECONDS=900
BACKUP_VERIFY_ENABLED=true
BACKUP_RESTORE_DRILL_ENABLED=false
BACKUP_RESTORE_DRILL_SCHEDULE=0 4 * * 0
POSTGRES_BACKUP_FORMAT=custom
POSTGRES_PG_DUMP_PATH=pg_dump
POSTGRES_PG_RESTORE_PATH=pg_restore
POSTGRES_PSQL_PATH=psql
POSTGRES_WAL_ARCHIVE_ENABLED=false
POSTGRES_WAL_ARCHIVE_PATH=
POSTGRES_PITR_ENABLED=false
RELEASE_ENABLED=false
RELEASE_ROOT=/opt/trademind/releases
RELEASE_ARTIFACT_DIR=artifacts/releases
RELEASE_CURRENT_LINK=/opt/trademind/releases/current
RELEASE_PREVIOUS_LINK=/opt/trademind/releases/previous
RELEASE_KEEP_COUNT=5
RELEASE_HEALTH_TIMEOUT_SECONDS=120
RELEASE_ROLLBACK_ON_FAILURE=true
RELEASE_REQUIRE_PRE_BACKUP=false
RELEASE_STRATEGY=blue_green
RELEASE_TRAFFIC_SWITCH_MODE=manual

# -----------------------------------------------------------------------------
# P7 性能守护（生产必须保持关闭）
# -----------------------------------------------------------------------------
PERFORMANCE_TEST_MODE=false
ALLOW_PERFORMANCE_DATASET=false
P7_DIAGNOSTICS_ENABLED=false
P7_DIAGNOSTIC_RUN_ID=
P7_DIAGNOSTIC_ROLE=
P7_DIAGNOSTIC_DIR=artifacts/p7-v2-diagnostics
P7_DIAGNOSTIC_BUFFER=4096
P7_DIAGNOSTIC_RUNTIME_SNAPSHOT_INTERVAL_MS=1000
EXTERNAL_PROVIDER_MODE=real
DOUYIN_WRITE_ENABLED=false
AUTO_LISTING_ENABLED=false
PERFORMANCE_DATASET_MAX_ROWS=2000000
PERFORMANCE_TEST_MAX_VUS=50
PERFORMANCE_TEST_MAX_DURATION_SECONDS=1800
PAGINATION_DEFAULT_LIMIT=50
PAGINATION_MAX_LIMIT=200
PAGINATION_MAX_OFFSET=10000
DB_MAX_OPEN_CONNECTIONS=100
DB_MAX_IDLE_CONNECTIONS=10
DB_CONN_MAX_LIFETIME_SECONDS=3600
DB_CONN_MAX_IDLE_TIME_SECONDS=900
DB_QUERY_TIMEOUT_MS=5000
DB_TRANSACTION_TIMEOUT_MS=10000
WORKER_CONCURRENCY_DEFAULT=2
WORKER_QUEUE_CAPACITY=1000
WORKER_MAX_INFLIGHT=100
WORKER_PREFETCH=10
WORKER_SHUTDOWN_TIMEOUT_SECONDS=60
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MODE=local
RATE_LIMIT_REDIS_PREFIX=trademind:ratelimit
RATE_LIMIT_FAIL_MODE=closed
RATE_LIMIT_LOCAL_FALLBACK=true
RATE_LIMIT_POLICY_VERSION=p7-default-v1
CACHE_ENABLED=true
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_MAX_ENTRIES=10000
CACHE_SINGLEFLIGHT_ENABLED=true
EXPORT_BATCH_SIZE=500
EXPORT_MAX_ROWS=100000
EXPORT_MAX_BYTES=104857600
EXPORT_MAX_CONCURRENT=2
PPROF_ENABLED=false
PPROF_INTERNAL_ONLY=true

UPLOAD_MAX_MB=10

# Inbound platform webhooks (public; no JWT)
WEBHOOK_MAX_BODY_KB=512
WEBHOOK_MAX_CLOCK_SKEW_SECONDS=300
WEBHOOK_ENABLE_TEST_VERIFIER=false
WEBHOOK_WORKER_INTERVAL_SECONDS=3
DOUYIN_WEBHOOK_TEST_SHOP_BINDING_ID=
ENABLE_DOUYIN_WEBHOOK_DEMO_FALLBACK=false
