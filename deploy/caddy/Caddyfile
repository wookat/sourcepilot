# TradeMind 生产反向代理（Caddy 2）
# - DOMAIN 为公网域名时自动申请 Let's Encrypt 证书（需 DNS A 记录已生效、80/443 可达）。
# - DOMAIN=localhost 或 IP 时 Caddy 自动改用内部自签 CA（本地/预发验证用）。
# - 联调 Let's Encrypt Staging：设 ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
{
	email {$ACME_EMAIL:admin@example.com}
	acme_ca {$ACME_CA:https://acme-v02.api.letsencrypt.org/directory}
}

{$DOMAIN} {
	encode gzip

	# 全部流量交给 admin(nginx)：静态资源直出，/api、/static 由 nginx 转发 backend
	reverse_proxy admin:80

	# admin 容器不可达（升级/重建期间）时给出友好的维护页，而非裸 502
	handle_errors {
		@upstream_down expression `{err.status_code} in [502, 503, 504]`
		handle @upstream_down {
			header Content-Type "text/html; charset=utf-8"
			header Cache-Control "no-store"
			respond <<HTML
				<!DOCTYPE html>
				<html lang="zh-CN">
				<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>系统升级维护中</title>
				<style>body{font-family:system-ui,sans-serif;display:flex;align-items:center;justify-content:center;min-height:100vh;margin:0;background:#f5f5f5;color:#333}main{text-align:center;padding:2rem}h1{font-size:1.5rem}</style>
				</head>
				<body><main><h1>系统升级维护中</h1><p>服务正在升级或重启，请稍后刷新重试。</p></main></body>
				</html>
				HTML 503
		}
	}
}
