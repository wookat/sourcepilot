        "status"
      ],
      "responseData": "McpAuditLogList",
      "responseFields": [
        "total",
        "items[].id",
        "items[].tokenId",
        "items[].tokenName",
        "items[].tokenMasked",
        "items[].tool",
        "items[].status",
        "items[].durationMs",
        "items[].createdAt"
      ],
      "forbiddenResponseFields": [
        "items[].plaintext",
        "items[].tokenHash",
        "items[].arguments",
        "items[].result"
      ],
      "note": "one row per MCP tool call; tool arguments and query results are never recorded"
    },
    {
      "method": "POST",
      "path": "/api/mcp",
      "auth": true,
      "authScheme": "bearer-mcp-readonly-token",
      "requestBody": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "responseData": "JsonRpcResult",
      "errorEnvelope": {
        "401": 40101,
        "429": 42901
      },
      "note": "MCP Streamable HTTP read-only entry; not the admin JSON envelope on success (JSON-RPC 2.0 body), errors before the MCP handler use the standard envelope"
    }
  ]
